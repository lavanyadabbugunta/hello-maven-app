
pipeline {
    agent any

    tools {
        maven 'mymaven'
    }

    stages {
        stage('Check Project') {
            steps {
                sh 'pwd'
                sh 'ls -la'
                sh 'find . -name pom.xml'
            }
        }

        stage('Build and Test') {
            steps {
                dir('hello-maven-app/hello-maven-app') {
                    sh 'mvn clean test'
                }
            }
        }

      stage('Generate WAR') {
    steps {
        dir('hello-maven-app/hello-maven-app') {
            sh 'mvn package'
        }
        archiveArtifacts artifacts: 'hello-maven-app/hello-maven-app/target/*.war',
                         fingerprint: true
    }
}
    }
}
